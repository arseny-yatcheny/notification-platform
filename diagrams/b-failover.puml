@startuml
hide footbox
skinparam dpi 175
skinparam defaultFontName Arial
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #276A79
  LifeLineBorderColor #78929B
  ParticipantBackgroundColor #E8F2F3
  ParticipantBorderColor #276A79
  ParticipantFontColor #153B48
  GroupBorderColor #8FAAB0
}
autonumber
participant "Workflow\nTemporal" as W
participant "Activity\nканала" as A
participant "Push /\nприложение" as P
participant "SMS-оператор" as S
participant "API / inbox" as G
W -> A: Попытка push
A -> P: Отправить push
P --> A: Принято шлюзом
A --> W: Ожидать квитанцию
... таймер 8 с; ACK нет ...
W -> W: Проверить состояние
W -> A: Попытка SMS
A -> A: Контакт, настройки, ключ
A -> S: Отправить SMS
S -> G: Финальный отчёт
G -> W: Signal после commit inbox
W -> A: Зафиксировать DELIVERED
P -> G: Запоздалый ACK push
G -> G: Сохранить как поздний ACK
note over W,A: Завершённый процесс не запускают заново.
@enduml
