@startuml
hide footbox
skinparam dpi 175
skinparam defaultFontName Arial
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #276A79
  LifeLineBorderColor #78929B
  ParticipantBackgroundColor #E8F2F3
  ParticipantBorderColor #276A79
  ParticipantFontColor #153B48
  GroupBorderColor #8FAAB0
}
autonumber
participant "Сервис банка" as S
participant "API" as G
database "PostgreSQL" as DB
participant "Ретранслятор\nи Kafka" as K
participant "Диспетчер /\nадаптер" as D
participant "Push /\nприложение" as P
S -> G: Событие списания
G -> DB: ID + outbox, commit
G --> S: Принято, ID
DB --> K: Событие из outbox
K -> D: Обработать ID
D -> DB: Попытка push + срок + outbox
DB --> K: Команда отправки
K -> D: Отправить с ключом попытки
D -> P: Push с ID
P --> G: ACK устройства
G -> DB: Сохранить квитанцию
DB --> K: ACK через relay
K -> D: Применить ACK
D -> DB: DELIVERED; срок неактуален
@enduml
